<ResourceDictionary
    x:Class="CosmicVaults.NINA.Astraeus.SequenceItems.AstraeusTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CosmicVaults.NINA.Astraeus.SequenceItems"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <GeometryGroup x:Key="Astraeus_CalibrationMasters_SVG">
        <RectangleGeometry Rect="0,0,100,22" RadiusX="4" RadiusY="4" />
        <RectangleGeometry Rect="0,39,100,22" RadiusX="4" RadiusY="4" />
        <RectangleGeometry Rect="0,78,100,22" RadiusX="4" RadiusY="4" />
    </GeometryGroup>

    <DataTemplate DataType="{x:Type local:GenerateCalibrationMastersInstruction}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Text="Generate &amp; upload calibration masters" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <!--  NINA finds the imaging-tab template by the instruction's full type name plus "_Mini"  -->
    <DataTemplate x:Key="CosmicVaults.NINA.Astraeus.SequenceItems.GenerateCalibrationMastersInstruction_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Text="Generate &amp; upload calibration masters" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>
</ResourceDictionary>

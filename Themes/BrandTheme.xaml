<!--
    The Astraeus brand look, from the website's palette and controls. AstraeusTheme loads it when the
    N.I.N.A. theme is off, which is the default.

    Unlike NinaTheme.xaml this has keyless implicit styles, so every bare control in the options views
    is restyled. That's only safe because AstraeusTheme is merged per view and never into
    Application.Current.Resources (see the note on the class).

    Most of this file was generated by AI from the website CSS, then tweaked by a designer.
-->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Surfaces  -->
    <SolidColorBrush x:Key="Ast.Bg" Color="#161B27" />
    <SolidColorBrush x:Key="Ast.BgPage" Color="#1D2331" />
    <SolidColorBrush x:Key="Ast.BgCard" Color="#283142" />
    <SolidColorBrush x:Key="Ast.BgRaised" Color="#323C50" />
    <SolidColorBrush x:Key="Ast.BgInset" Color="#1F2632" />
    <SolidColorBrush x:Key="Ast.Ink" Color="#080B11" />
    <SolidColorBrush x:Key="Ast.Divider" Color="#2C354A" />
    <!-- Label colour for text sitting on a bright accent (gold/violet/danger buttons).  -->
    <SolidColorBrush x:Key="Ast.OnAccent" Color="#000000" />
    
    <!--  Text  -->
    <SolidColorBrush x:Key="Ast.Text" Color="#EEF1F6" />
    <SolidColorBrush x:Key="Ast.TextDim" Color="#9FA8BD" />
    <SolidColorBrush x:Key="Ast.TextFaint" Color="#6C7488" />

    <!--  Accents  -->
    <SolidColorBrush x:Key="Ast.Gold" Color="#F2B14A" />
    <SolidColorBrush x:Key="Ast.Violet" Color="#B07CE0" />

    <!--  Status  -->
    <SolidColorBrush x:Key="Ast.Safe" Color="#74D89B" />
    <SolidColorBrush x:Key="Ast.Warning" Color="#DEA24A" />
    <SolidColorBrush x:Key="Ast.Info" Color="#4A9BD0" />

    <!-- The website style gradient: CSS linear-gradient(170deg, HI 0 44%, BASE 44% 100%) -->
    <LinearGradientBrush x:Key="Ast.GoldGrad" StartPoint="0.087,0" EndPoint="-0.087,1">
        <GradientStop Offset="0" Color="#FFCE76" />
        <GradientStop Offset="0.44" Color="#FFCE76" />
        <GradientStop Offset="0.44" Color="#F2B14A" />
        <GradientStop Offset="1" Color="#F2B14A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Ast.DangerGrad" StartPoint="0.087,0" EndPoint="-0.087,1">
        <GradientStop Offset="0" Color="#F3938B" />
        <GradientStop Offset="0.44" Color="#F3938B" />
        <GradientStop Offset="0.44" Color="#E05750" />
        <GradientStop Offset="1" Color="#E05750" />
    </LinearGradientBrush>

    <!--
        Fonts by name with fallbacks. The brand fonts are Google Fonts and rarely installed, so WPF
        walks the list per glyph and lands on the system default. Consolas ships with every Windows
        and Cascadia Mono with Win11, so the mono look always survives.
    -->
    <FontFamily x:Key="Ast.Display">Space Grotesk, Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Ast.Body">IBM Plex Sans, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Ast.Mono">IBM Plex Mono, Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--  ===== Text =====  -->

    <Style x:Key="Ast.TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ast.Body}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style BasedOn="{StaticResource Ast.TextBase}" TargetType="TextBlock" />

    <Style x:Key="Ast.PageTitle" BasedOn="{StaticResource Ast.TextBase}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ast.Display}" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ast.Text}" />
    </Style>

    <Style x:Key="Ast.PageSub" BasedOn="{StaticResource Ast.TextBase}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Ast.TextFaint}" />
    </Style>

    <!--
        A heading inside a card, in the display face so it stands clear of the mono labels around
        it. Louder than the card's own header, since the card's frame already marks the outer level.
    -->
    <Style x:Key="Ast.SectionHeader" BasedOn="{StaticResource Ast.TextBase}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ast.Display}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ast.Text}" />
    </Style>

    <Style x:Key="Ast.CardHeader" BasedOn="{StaticResource Ast.TextBase}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ast.Mono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ast.TextDim}" />
    </Style>

    <Style x:Key="Ast.Label" BasedOn="{StaticResource Ast.TextBase}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ast.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Ast.TextDim}" />
    </Style>

    <Style x:Key="Ast.Hint" BasedOn="{StaticResource Ast.TextBase}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Ast.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  ===== Page ground =====  -->

    <!--
        The frame the whole options page sits in. Opaque because N.I.N.A.'s background follows the
        profile colour schema and may be light. OptionsPageView.xaml sets the inherited font and
        foreground on the element itself.
    -->
    <Style x:Key="Ast.PageGround" TargetType="Border">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Background" Value="{StaticResource Ast.BgPage}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ast.Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="13" />
    </Style>

    <!--  ===== Cards =====  -->
    <Style x:Key="Ast.Card" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Border Margin="4,5,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="13" />
                        <Border Margin="0,0,4,5"
                                Padding="18"
                                Background="{StaticResource Ast.BgCard}"
                                BorderBrush="{StaticResource Ast.Ink}"
                                BorderThickness="2"
                                CornerRadius="13">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Ast.CardHeader}"
                                           Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Border Height="1" Margin="0,10,0,16" Background="{StaticResource Ast.Divider}" />
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A section inside a card, with a hairline and then a violet-ticked heading over the content.
        Violet because gold means "on" or "press me" everywhere else.
    -->
    <Style x:Key="Ast.Section" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,28,0,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <Border Height="1" Margin="0,0,0,20" Background="{StaticResource Ast.Divider}" />
                        <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                            <Border Width="4"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Ast.Violet}"
                                    CornerRadius="2" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Ast.SectionHeader}"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                        </StackPanel>
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Buttons =====  -->

    <Style x:Key="Ast.ButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Ast.GoldGrad}" />
        <Setter Property="Foreground" Value="{StaticResource Ast.OnAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource Ast.Display}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Plate" Margin="2,2,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="10" />
                        <Border x:Name="Face"
                                Margin="0,0,2,2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Ast.Ink}"
                                BorderThickness="2"
                                CornerRadius="10">
                            <Grid>
                                <Border x:Name="Wash" Background="White" CornerRadius="8" Opacity="0" />
                                <!--
                                    A TextBlock instead of a ContentPresenter, whose generated
                                    TextBlock picks up N.I.N.A.'s app-level style, and that
                                    Foreground beats the one we inherit. A local Foreground here
                                    always wins. Our buttons are all text, so revisit if one
                                    needs other content.
                                -->
                                <TextBlock Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <!--  Pressing drops the face onto its own shadow.  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="2,2,0,0" />
                            <Setter TargetName="Plate" Property="Opacity" Value="0" />
                            <Setter TargetName="Wash" Property="Background" Value="{StaticResource Ast.Ink}" />
                            <Setter TargetName="Wash" Property="Opacity" Value="0.2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Ast.ButtonBase}" TargetType="Button" />

    <Style x:Key="Ast.ButtonNeutral" BasedOn="{StaticResource Ast.ButtonBase}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Ast.BgRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Ast.Text}" />
    </Style>

    <Style x:Key="Ast.ButtonDanger" BasedOn="{StaticResource Ast.ButtonBase}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Ast.DangerGrad}" />
    </Style>

    <!--  ===== TextBox =====  -->

    <Style x:Key="Ast.TextBoxBase" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ast.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ast.Gold}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Ast.Violet}" />
        <Setter Property="FontFamily" Value="{StaticResource Ast.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="Root">
                        <Border Margin="1,1,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="10" />
                        <Border x:Name="Face"
                                Margin="0,0,1,1"
                                Background="{StaticResource Ast.BgInset}"
                                BorderBrush="{StaticResource Ast.Ink}"
                                BorderThickness="2"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Read-only path fields should read as displays, not inputs.  -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Ast.Bg}" />
                            <Setter Property="Foreground" Value="{StaticResource Ast.TextDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Ast.TextBoxBase}" TargetType="TextBox" />

    <!--  ===== PasswordBox =====  -->
    <!--
        Looks the same as Ast.TextBoxBase. It's a separate style because PasswordBox doesn't derive
        from TextBox and has no IsReadOnly, so the triggers differ. Edit the two together.
    -->

    <Style x:Key="Ast.PasswordBoxBase" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource Ast.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ast.Gold}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Ast.Violet}" />
        <Setter Property="FontFamily" Value="{StaticResource Ast.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid x:Name="Root">
                        <Border Margin="1,1,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="10" />
                        <Border x:Name="Face"
                                Margin="0,0,1,1"
                                Background="{StaticResource Ast.BgInset}"
                                BorderBrush="{StaticResource Ast.Ink}"
                                BorderThickness="2"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Ast.PasswordBoxBase}" TargetType="PasswordBox" />

    <!--  ===== ComboBox =====  -->

    <ControlTemplate x:Key="Ast.ComboBoxToggle" TargetType="ToggleButton">
        <Border Background="Transparent" />
    </ControlTemplate>

    <Style x:Key="Ast.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Foreground" Value="{StaticResource Ast.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Ast.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Margin="4,2"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <!--
                                    DisplayMemberPath makes WPF generate the TextBlock, so it
                                    can't get a local Foreground like the Button template. This
                                    empty style displaces N.I.N.A.'s app-level TextBlock style,
                                    whose Foreground would beat inheritance, so the
                                    TextElement.Foreground above paints the text.
                                -->
                                <Style TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ast.BgRaised}" />
                        </Trigger>
                        <!--  Declared after IsHighlighted so selection wins while hovered.  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ast.Gold}" />
                            <Setter Property="Foreground" Value="{StaticResource Ast.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ast.ComboBoxBase" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Ast.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Ast.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!--  Explicit, so we don't rely on implicit lookup reaching generated containers.  -->
        <Setter Property="ItemContainerStyle" Value="{StaticResource Ast.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <Border Margin="1,1,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="10" />
                        <Border x:Name="Face"
                                Margin="0,0,1,1"
                                Background="{StaticResource Ast.BgInset}"
                                BorderBrush="{StaticResource Ast.Ink}"
                                BorderThickness="2"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False"
                                                  TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <!--  Same generated TextBlock problem as in Ast.ComboBoxItem.  -->
                                        <Style TargetType="TextBlock" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <!--  Stroke-drawn chevron, matching the site's 1.7px round-cap icons.  -->
                                <Path x:Name="Chevron"
                                      Grid.Column="1"
                                      Margin="4,0,13,0"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L5,5.5 L10,0"
                                      IsHitTestVisible="False"
                                      Stroke="{StaticResource Ast.TextDim}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.7" />
                            </Grid>
                        </Border>

                        <ToggleButton ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource Ast.ComboBoxToggle}" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Grid MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  Margin="0,4,4,5">
                                <Border Margin="3,4,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="10" />
                                <Border Margin="0,0,3,4"
                                        Padding="0,6"
                                        Background="{StaticResource Ast.BgCard}"
                                        BorderBrush="{StaticResource Ast.Ink}"
                                        BorderThickness="2"
                                        CornerRadius="10">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Ast.Gold}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Ast.Gold}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Ast.TextFaint}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Ast.ComboBoxBase}" TargetType="ComboBox" />

    <!--  ===== Toggle switch =====  -->

    <Style x:Key="Ast.ToggleBase" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Root" Orientation="Horizontal">
                        <Grid Width="41" Height="23">
                            <Border Margin="1,1,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="11" />
                            <Border x:Name="Track"
                                    Margin="0,0,1,1"
                                    BorderBrush="{StaticResource Ast.Ink}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <!--
                                    Declared inline so each instance has its own unfrozen brush.
                                    A ColorAnimation on a StaticResource brush would throw.
                                -->
                                <Border.Background>
                                    <SolidColorBrush Color="#1F2632" />
                                </Border.Background>
                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Margin="1,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="#9FA8BD" />
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <Border x:Name="FocusRing"
                                    Margin="-3"
                                    BorderBrush="{StaticResource Ast.Info}"
                                    BorderThickness="2"
                                    CornerRadius="13"
                                    Opacity="0" />
                        </Grid>
                        <ContentPresenter x:Name="Cp" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!--  Most of ours are bare toggles with a sibling TextBlock label.  -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Cp" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="18"
                                                         Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="#F2B14A"
                                                        Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="Thumb"
                                                        Storyboard.TargetProperty="Fill.(SolidColorBrush.Color)"
                                                        To="#080B11"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                        To="#1F2632"
                                                        Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="Thumb"
                                                        Storyboard.TargetProperty="Fill.(SolidColorBrush.Color)"
                                                        To="#9FA8BD"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Ast.ToggleBase}" TargetType="CheckBox" />

    <!--  ===== Slider =====  -->
    <!--
        Horizontal only with no tick bars, since our sliders are all horizontal with ticks too dense
        to draw.
    -->

    <!--  The groove left of the thumb. Square on the right, where the thumb covers the join.  -->
    <Style x:Key="Ast.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Height="10" VerticalAlignment="Center" Background="Transparent">
                        <Border Margin="0,0,0,1"
                                Background="{StaticResource Ast.Gold}"
                                BorderBrush="{StaticResource Ast.Ink}"
                                BorderThickness="2,2,0,2"
                                CornerRadius="5,0,0,5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The groove right of the thumb. Nothing is drawn so the rail shows through, but it's still clickable.  -->
    <Style x:Key="Ast.SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ast.SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Plate" Margin="1,1,0,0" Fill="{StaticResource Ast.Ink}" />
                        <Grid x:Name="Face" Margin="0,0,1,1">
                            <Ellipse Fill="{StaticResource Ast.GoldGrad}" Stroke="{StaticResource Ast.Ink}" StrokeThickness="2" />
                            <Ellipse x:Name="Wash" Margin="2" Fill="White" Opacity="0" />
                        </Grid>
                        <!--  The slider takes the focus, not the thumb, so the ring watches the slider.  -->
                        <Ellipse x:Name="FocusRing"
                                 Margin="-3"
                                 Opacity="0"
                                 Stroke="{StaticResource Ast.Info}"
                                 StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="1,1,0,0" />
                            <Setter TargetName="Plate" Property="Opacity" Value="0" />
                            <Setter TargetName="Wash" Property="Fill" Value="{StaticResource Ast.Ink}" />
                            <Setter TargetName="Wash" Property="Opacity" Value="0.2" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ast.SliderBase" TargetType="Slider">
        <!--  A click on the groove jumps the thumb there, as the web page's range input does.  -->
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!--  26 high leaves room for the thumb's focus ring.  -->
                    <Grid x:Name="Root" MinHeight="26" Background="Transparent">
                        <Grid Height="10" VerticalAlignment="Center">
                            <Border Margin="1,1,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="5" />
                            <Border Margin="0,0,1,1"
                                    Background="{StaticResource Ast.BgInset}"
                                    BorderBrush="{StaticResource Ast.Ink}"
                                    BorderThickness="2"
                                    CornerRadius="5" />
                        </Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Ast.SliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Ast.SliderEmpty}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Ast.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Ast.SliderBase}" TargetType="Slider" />

    <!--  ===== Banner, dot, info icon, tooltip =====  -->

    <Style x:Key="Ast.Banner" TargetType="ContentControl">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="1,1,0,0" Background="{StaticResource Ast.Ink}" CornerRadius="12" />
                        <Border Margin="0,0,1,1"
                                Background="{StaticResource Ast.BgCard}"
                                BorderBrush="{StaticResource Ast.Ink}"
                                BorderThickness="1.8"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Ast.Warning}" CornerRadius="10,0,0,10" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="14,12,16,12"
                                                  TextElement.FontSize="12.5"
                                                  TextElement.Foreground="{StaticResource Ast.TextDim}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ast.Dot" TargetType="Ellipse">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Fill" Value="{StaticResource Ast.TextFaint}" />
        <Setter Property="Stroke" Value="{StaticResource Ast.Ink}" />
        <Setter Property="StrokeThickness" Value="1.8" />
    </Style>

    <!--
        A circled "i" with its explanation in the ToolTip, drawn in strokes to match the combo box
        chevron. Give it a TextBlock with MaxWidth and wrapping, since a plain string runs on in one
        line. Held open a minute because five seconds is too short for a paragraph, and shown when its
        section is off because that's when the explanation is wanted most.
    -->
    <Style x:Key="Ast.InfoIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Canvas Width="16" Height="16" Background="Transparent">
                        <Ellipse x:Name="Ring"
                                 Width="16"
                                 Height="16"
                                 Stroke="{StaticResource Ast.TextDim}"
                                 StrokeThickness="1.5" />
                        <Ellipse x:Name="Dot"
                                 Canvas.Left="6.9"
                                 Canvas.Top="3.9"
                                 Width="2.2"
                                 Height="2.2"
                                 Fill="{StaticResource Ast.TextDim}" />
                        <Path x:Name="Stem"
                              Data="M8,7.2 L8,11.6"
                              Stroke="{StaticResource Ast.TextDim}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.7" />
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Ast.Gold}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Ast.Gold}" />
                            <Setter TargetName="Stem" Property="Stroke" Value="{StaticResource Ast.Gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ast.ToolTipBase" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Ast.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Ast.Body}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="10,7"
                            Background="{StaticResource Ast.BgRaised}"
                            BorderBrush="{StaticResource Ast.Ink}"
                            BorderThickness="2"
                            CornerRadius="8">
                        <ContentPresenter TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <!--  Tooltip content is a string, so WPF generates the TextBlock. See Ast.ComboBoxItem.  -->
                                <Style TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Ast.ToolTipBase}" TargetType="ToolTip" />

</ResourceDictionary>

<UserControl x:Class="CosmicVaults.NINA.Astraeus.Controls.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:CosmicVaults.NINA.Astraeus.Themes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:AstraeusTheme />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <StackPanel Margin="0,0,0,18" Orientation="Horizontal">
            <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                <Ellipse Style="{DynamicResource Ast.Dot}" />
                <Ellipse Fill="{DynamicResource Ast.Safe}"
                         Style="{DynamicResource Ast.Dot}"
                         Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding AccountLabel}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <Button MinWidth="160"
                    Margin="0,0,10,0"
                    Command="{Binding SignInCommand}"
                    Content="Sign in with browser"
                    Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}" />

            <Button MinWidth="100"
                    Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Style="{DynamicResource Ast.ButtonNeutral}"
                    Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}" />

            <Button MinWidth="100"
                    Command="{Binding SignOutCommand}"
                    Content="Sign out"
                    Style="{DynamicResource Ast.ButtonDanger}"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <TextBlock Margin="0,18,0,0" Style="{DynamicResource Ast.Hint}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" Style="{DynamicResource Ast.Hint}" Text="{Binding ServerLabel}" />

    </StackPanel>
</UserControl>

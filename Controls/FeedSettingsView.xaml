<UserControl x:Class="CosmicVaults.NINA.Astraeus.Controls.FeedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:CosmicVaults.NINA.Astraeus.Themes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:AstraeusTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <ContentControl Margin="0,0,0,20" Style="{DynamicResource Ast.Banner}">
            <TextBlock Text="Show an all-sky or observatory webcam on the Astraeus dashboard. Frames are captured and sent only while somebody is looking at the webcam card; while nobody is, the camera is left alone."
                       TextWrapping="Wrap" />
        </ContentControl>

        <StackPanel Margin="0,0,0,18" Orientation="Horizontal">
            <CheckBox IsChecked="{Binding IsFeedEnabled, Mode=TwoWay}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Enable webcam feed" />
        </StackPanel>

        <TextBlock Margin="0,0,0,6" Style="{DynamicResource Ast.Label}" Text="Source type" />
        <ComboBox Margin="0,0,0,18"
                  DisplayMemberPath="DisplayName"
                  ItemsSource="{Binding SourceKinds}"
                  SelectedValue="{Binding SourceKind, Mode=TwoWay}"
                  SelectedValuePath="Value" />

        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Ast.Label}" Text="Feed URL" />
            <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Ast.InfoIcon}">
                <ContentControl.ToolTip>
                    <TextBlock MaxWidth="360" TextWrapping="Wrap" Text="{Binding UrlHint}" />
                </ContentControl.ToolTip>
            </ContentControl>
        </StackPanel>
        <TextBox Margin="0,0,0,18" Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,10,0"
                       Style="{DynamicResource Ast.Label}"
                       Text="Username (optional)" />
            <TextBlock Grid.Column="1" Style="{DynamicResource Ast.Label}" Text="Password (optional)" />
        </Grid>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Margin="0,0,10,0"
                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <!--  PasswordBox has no bindable Password, so the code-behind pushes it into the VM.  -->
            <PasswordBox x:Name="FeedPasswordBox"
                         Grid.Column="1"
                         Margin="0,0,10,0"
                         PasswordChanged="FeedPasswordBox_PasswordChanged" />
            <Button Grid.Column="2"
                    Command="{Binding ClearPasswordCommand}"
                    Content="Clear"
                    Style="{DynamicResource Ast.ButtonNeutral}" />
        </Grid>
        <TextBlock Margin="0,0,0,20"
                   Style="{DynamicResource Ast.Hint}"
                   Text="{Binding PasswordStatus}"
                   TextWrapping="Wrap" />

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Ast.Label}" Text="Max width (px)" />
                <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Ast.InfoIcon}">
                    <ContentControl.ToolTip>
                        <TextBlock MaxWidth="360"
                                   TextWrapping="Wrap"
                                   Text="Longest edge of an uploaded frame. 640 px is enough to see whether the roof is open." />
                    </ContentControl.ToolTip>
                </ContentControl>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Ast.Label}" Text="JPEG quality" />
                <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Ast.InfoIcon}">
                    <ContentControl.ToolTip>
                        <TextBlock MaxWidth="360"
                                   TextWrapping="Wrap"
                                   Text="Higher costs bandwidth for detail a monitoring view rarely needs." />
                    </ContentControl.ToolTip>
                </ContentControl>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Ast.Label}" Text="Frame interval" />
                <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Ast.InfoIcon}">
                    <ContentControl.ToolTip>
                        <TextBlock MaxWidth="360"
                                   TextWrapping="Wrap"
                                   Text="How often a frame is sent while somebody is looking at the webcam card. Nothing is captured while nobody is. Faster costs bandwidth: every frame goes to each watching browser." />
                    </ContentControl.ToolTip>
                </ContentControl>
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Fixed lists instead of number boxes, so each limit is a choice and never a silent clamp.  -->
            <ComboBox Grid.Column="0"
                      Margin="0,0,10,0"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding WidthOptions}"
                      SelectedValue="{Binding MaxWidth, Mode=TwoWay}"
                      SelectedValuePath="Value" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,10,0"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding QualityOptions}"
                      SelectedValue="{Binding JpegQuality, Mode=TwoWay}"
                      SelectedValuePath="Value" />
            <ComboBox Grid.Column="2"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding IntervalOptions}"
                      SelectedValue="{Binding IntervalSeconds, Mode=TwoWay}"
                      SelectedValuePath="Value" />
        </Grid>

        <TextBlock Margin="0,0,0,20"
                   Style="{DynamicResource Ast.Hint}"
                   Text="{Binding BandwidthEstimate}"
                   TextWrapping="Wrap" />

        <!--  Test connection is the card's primary action, so it stays gold.  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding TestConnectionCommand}"
                    Content="{Binding TestButtonText}" />
            <TextBlock Grid.Column="1"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Style="{DynamicResource Ast.Hint}"
                       Text="{Binding TestStatus}"
                       TextWrapping="Wrap" />
        </Grid>

    </StackPanel>
</UserControl>
